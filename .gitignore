# ────────────────────────────────────────────
#  Inama — .gitignore
#  Stack: Go · Python/FastAPI · Next.js · Docker
# ────────────────────────────────────────────


# ── Secrets & environment ────────────────────
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx


# ── Go ──────────────────────────────────────
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
go.work
go.work.sum


# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.cover
.hypothesis/


# ── Node.js / Next.js ────────────────────────
node_modules/
.next/
out/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo


# ── Docker ───────────────────────────────────
# keep docker-compose files, ignore local overrides that may have secrets
docker-compose.override.yml


# ── Databases & persistent volumes ──────────
postgres_data/
redis_data/
elasticsearch_data/
kafka_data/
zookeeper_data/
*.sql.bak
*.dump


# ── Logs ────────────────────────────────────
*.log
logs/
log/


# ── Protobuf generated code ──────────────────
# Generated code IS committed, under proto/gen/ (single source of truth,
# produced by `make gen`). So it is intentionally NOT ignored here.


# ── Monitoring data ──────────────────────────
prometheus_data/
grafana_data/
tempo_data/
loki_data/


# ── OS ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
.Spotlight-V100
.Trashes


# ── IDEs ────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~


# ── Test & coverage artifacts ────────────────
coverage/
*.lcov
test-results/
junit.xml


# ── Misc ────────────────────────────────────
todo.txt
*.tmp
*.bak
*.orig
.claude 
claude_should*
